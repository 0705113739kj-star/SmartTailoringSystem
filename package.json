{
  "name": "smarttailoringsystem",
  "private": true,
  "version": "1.0.0",
  "description": "SmartTailoringSystem — Standalone Offline Windows Desktop Tailoring POS & Workshop Management",
  "author": "SmartTailoringSystem",
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "tsx server.ts",
    "build:web": "tsx scripts/copy-wasm.ts && vite build",
    "build:server": "esbuild server.ts --bundle --platform=node --format=esm --packages=external --outfile=server.js",
    "build:electron": "esbuild electron/main.ts --bundle --platform=node --format=cjs --external:electron --external:node:sqlite --outfile=dist-electron/main.cjs && esbuild electron/preload.ts --bundle --platform=node --format=cjs --external:electron --outfile=dist-electron/preload.cjs",
    "build": "npm run build:web && npm run build:server && npm run build:electron",
    "start": "node server.js",
    "preview": "vite preview",
    "desktop:dev": "npm run build:electron && electron .",
    "dist:win": "npm run build:web && npm run build:electron && electron-builder --win nsis",
    "dist:msix": "npm run build:web && npm run build:electron && electron-builder --win appx",
    "mobile:sync": "npm run build:web && npx cap sync android",
    "mobile:android": "npm run mobile:sync && npx cap open android",
    "mobile:apk": "npm run mobile:sync && node -e \"const cp=require('child_process'); const path=require('path'); const cmd=process.platform==='win32'?'gradlew.bat':'./gradlew'; cp.execFileSync(cmd,['assembleDebug'],{cwd:path.resolve('android'),stdio:'inherit'});\"",
    "db:init": "tsx scripts/db-cli.ts init",
    "db:migrate": "tsx scripts/db-cli.ts migrate",
    "icons:generate": "tsx scripts/generate-icons.ts",
    "clean": "rm -rf dist dist-electron server.js release",
    "lint": "tsc --noEmit",
    "test": "NODE_ENV=test tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/cli": "^8.6.3",
    "@capacitor/core": "^8.6.3",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/share": "^8.0.3",
    "@noble/hashes": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/cookie-parser": "^1.4.10",
    "@types/sql.js": "^1.16.1",
    "@vitejs/plugin-react": "^6.1.1",
    "chart.js": "^4.6.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "sql.js": "^1.17.0",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "electron": "^45.5.0",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  }
}
