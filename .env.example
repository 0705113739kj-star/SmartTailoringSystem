# SmartTailoringSystem Local Desktop Runtime (Development / Override Options)
# The packaged Windows desktop application runs fully locally and does not require a .env file.

PORT=3000
NODE_ENV=development

# Optional override for local SQLite database path during development.
# When unset, packaged Electron stores data persistently at:
#   Windows: %LOCALAPPDATA%\SmartTailoringSystem\data\smarttailoring.db
#   Linux/macOS: <userData>/data/smarttailoring.db
#   Browser Dev Mode: ./data/smarttailoring.db
SMARTTAILORING_DB_PATH=""

# Optional local session signing secret override (auto-generated & persisted in Local AppData if unset)
SESSION_SECRET=""
